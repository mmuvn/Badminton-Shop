<Window x:Class="PRN212_BadmintonShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Badminton Shop - Dashboard" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignDarkBackground}" TextElement.Foreground="{DynamicResource MaterialDesignDarkForeground}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Badminton Shop" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Products" Click="BtnProducts_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />
                    
                    <Button Content="My History" Click="BtnMyHistory_Click" Visibility="{Binding IsCustomer, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />

                    <Button Content="Request Service" Click="BtnRequestService_Click" Visibility="{Binding IsCustomer, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />
                    
                    <Button Content="Order Queue" Click="BtnOrderQueue_Click" Visibility="{Binding IsStaffOrAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />
                    <Button Content="Service Queue" Click="BtnServiceQueue_Click" Visibility="{Binding IsStaffOrAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />
                    
                    <Button Content="Manage Users" Click="BtnManageUsers_Click" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />
                    <Button Content="Reports" Click="BtnReports_Click" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource MaterialDesignDarkForeground}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl x:Name="MainContent" Grid.Row="1" />
        
    </Grid>
</Window>
