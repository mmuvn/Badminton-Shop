<Window x:Class="PRN212_BadmintonShop.Views.ServiceRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Request Service" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select Service" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="rbNewString" Content="New String" IsChecked="True" Checked="RbService_Checked" Margin="0,0,24,0" />
            <RadioButton x:Name="rbWeldFrame" Content="Weld Frame" Checked="RbService_Checked" />
        </StackPanel>

        <!-- New String Panel -->
        <StackPanel x:Name="pnlNewString" Grid.Row="2">
            <TextBlock Text="Select String:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="cbStringProduct" DisplayMemberPath="ProductName" SelectionChanged="CbStringProduct_SelectionChanged" Margin="0,0,0,16" />
            
            <TextBlock Text="Color:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="txtStringColor" Text="-" Opacity="0.7" Margin="0,0,0,16" />

            <TextBlock Text="Requested Tension (Lbs):" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="txtTension" Text="24" Margin="0,0,0,16" />

            <TextBlock Text="Service Price:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="txtStringPrice" Text="0₫" FontSize="18" Foreground="{DynamicResource PrimaryHueMidBrush}" />
        </StackPanel>

        <!-- Weld Frame Panel -->
        <StackPanel x:Name="pnlWeldFrame" Grid.Row="2" Visibility="Collapsed">
            <TextBlock Text="Frame Condition Description:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="txtCondition" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Margin="0,0,0,16" />

            <TextBlock Text="Service Price:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="100,000₫" FontSize="18" Foreground="{DynamicResource PrimaryHueMidBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Submit Request" Click="BtnSubmit_Click" Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
        </StackPanel>
    </Grid>
</Window>
