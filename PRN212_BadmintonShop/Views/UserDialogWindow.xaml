<Window x:Class="PRN212_BadmintonShop.Views.UserDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Create User" Height="450" Width="350"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create New User" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtUsername" Margin="0,0,0,16" />

            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtEmail" Margin="0,0,0,16" />
            
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtPassword" Margin="0,0,0,16" />
            
            <TextBlock Text="Role" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="rbCustomer" Content="Customer" IsChecked="True" Margin="0,0,16,0" />
                <RadioButton x:Name="rbStaff" Content="Staff" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Save" Click="BtnSave_Click" Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
        </StackPanel>
    </Grid>
</Window>
